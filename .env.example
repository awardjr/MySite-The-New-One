# ==============================================================================
# Server & Deployment Configuration (adapter-node)
# ==============================================================================
# Set ORIGIN to match the public URL where users/admins access the application.
# For local Podman containers: http://localhost:6941
# For production VPS with HTTPS: https://yourdomain.com
ORIGIN=http://localhost:6941
# Optional comma-separated additional trusted origins for cross-origin form submissions:
TRUSTED_ORIGINS=http://localhost:6941,http://127.0.0.1:6941

# ==============================================================================
# SMTP / Email Configuration (Password Reset & Admin Notifications)
# ==============================================================================
# If SMTP_HOST or SMTP_SERVICE is not set, reset links will be printed to the
# server console for local development and testing.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Site Admin" <noreply@example.com>
SMTP_SECURE=false

# Optional SMTP Settings:
# SMTP_SERVICE=gmail
# SMTP_REQUIRE_TLS=true
# SMTP_IGNORE_TLS=false
