{
	"name": "mysite-the-new-one",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bash scripts/dev-cert.sh && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"podman:build": "bash scripts/podman.sh build",
		"podman:up": "bash scripts/podman.sh up",
		"podman:down": "bash scripts/podman.sh down",
		"podman:logs": "bash scripts/podman.sh logs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/etag": "^1.8.4",
		"@types/fresh": "^0.5.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^24.13.6",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"otpauth": "^9.6.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@better-auth/utils": "^0.5.1",
		"@fontsource-variable/raleway": "^5.3.0",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@node-rs/argon2": "^2.2.2",
		"@sindresorhus/slugify": "^4.0.1",
		"better-auth": "^1.7.18",
		"better-sqlite3": "^13.0.3",
		"ckeditor5": "^48.5.2",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.17",
		"etag": "^1.8.1",
		"feed": "^6.0.0",
		"fresh": "^0.5.2",
		"jsdom": "^30.1.3",
		"nodemailer": "^10.6.0",
		"qrcode": "^1.5.4",
		"rate-limiter-flexible": "^11.3.0",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.5",
		"sitemap": "^10.0.0",
		"svelte-fa": "^4.0.4",
		"umzug": "^3.8.3",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
