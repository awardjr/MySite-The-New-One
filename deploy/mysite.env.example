# Copy to ~/.config/mysite/mysite.env on the VPS (chmod 600)

# ==============================================================================
# Domain / reverse proxy
# ==============================================================================
# Public URL of the site, with https://. Must match MYSITE_DOMAIN in the shared
# Caddy's caddy.env (mycaddy repo). Password-reset emails and the RSS feed build
# their links from this, so it must be set: without it they fall back to the
# request's Host header, which a client can forge.
#
# SvelteKit's own origin (used for the CSRF check on form posts) is fixed at build
# time instead. The published image is built without one, so it derives the origin
# from the Host header Caddy forwards. To pin it, set the SITE_ORIGIN repository
# variable (see .github/workflows/deploy.yml) and rebuild.
ORIGIN=https://example.com

# Optional: require this token on the one-time /admin/setup form, so nobody else can
# claim the admin account between the first deploy and your first visit. It can be
# removed once the account exists.
# SETUP_TOKEN=

# Take the client IP from the header Caddy sets, so login/reset rate limiting
# sees real visitors instead of the proxy. The shared Caddy is the only trusted hop.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Request body limit for adapter-node (default 512K is below the 5 MB upload limit).
BODY_SIZE_LIMIT=10M

# ==============================================================================
# Two-Factor Authentication
# ==============================================================================
# Required before enabling 2FA. Generate with `openssl rand -base64 32` and keep
# a secure backup; losing it prevents authenticator codes from being checked.
TOTP_ENCRYPTION_KEY=

# ==============================================================================
# SMTP / Email (password reset). See .env.example for all options.
# ==============================================================================
# If SMTP_HOST or SMTP_SERVICE is not set, reset links are only printed to the
# container log (journalctl --user -u mysite).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Site Admin" <noreply@example.com>
SMTP_SECURE=false
