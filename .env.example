# ==============================================================================
# Server & Deployment Configuration (adapter-node)
# ==============================================================================
# PORT=3000
# HOST=0.0.0.0
# ORIGIN=https://example.com
# BODY_SIZE_LIMIT=52428800

# ==============================================================================
# Two-Factor Authentication
# ==============================================================================
# Required before enabling 2FA. Generate a stable, private key with:
# openssl rand -base64 32
# Keep a secure backup; losing it prevents authenticator codes from being checked.
TOTP_ENCRYPTION_KEY=

# ==============================================================================
# SMTP / Email Configuration (Password Reset & Admin Notifications)
# ==============================================================================
# If SMTP_HOST or SMTP_SERVICE is not set, reset links will be printed to the
# server console for local development and testing.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Site Admin" <noreply@example.com>
SMTP_SECURE=false

# Optional SMTP Settings:
# SMTP_SERVICE=gmail
# SMTP_REQUIRE_TLS=true
# SMTP_IGNORE_TLS=false
