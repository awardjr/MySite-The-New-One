# ==============================================================================
# Server & Deployment Configuration (adapter-node)
# ==============================================================================
# PORT=3000
# HOST=0.0.0.0
# Public URL of the site. Used for links in password-reset emails and the RSS feed;
# when set while running `npm run build` it is also baked in as SvelteKit's origin.
# ORIGIN=https://example.com
# BODY_SIZE_LIMIT=52428800

# ==============================================================================
# First-time setup
# ==============================================================================
# Optional: when set, the one-time /admin/setup form also asks for this token.
# SETUP_TOKEN=

# ==============================================================================
# Admin Sign-In
# ==============================================================================
# Required in production. Signs session cookies and encrypts two-factor secrets.
# Generate with `openssl rand -base64 32` and keep a secure backup: changing it
# signs everyone out and stops existing authenticator codes from working.
BETTER_AUTH_SECRET=

# ==============================================================================
# SMTP / Email Configuration (Password Reset & Admin Notifications)
# ==============================================================================
# If SMTP_HOST or SMTP_SERVICE is not set, reset links will be printed to the
# server console for local development and testing.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Site Admin" <noreply@example.com>
SMTP_SECURE=false

# Optional SMTP Settings:
# SMTP_SERVICE=gmail
# SMTP_REQUIRE_TLS=true
# SMTP_IGNORE_TLS=false
